# PostHog (EU cloud), proxied through /ingest. Unset = silent no-op.
NEXT_PUBLIC_POSTHOG_KEY=

# Bing Webmaster Tools verification token.
# Bing Webmaster Tools > Add site > Meta tag > copy the content="..." value.
# Alternatively use "Import from Google Search Console", which skips this.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
